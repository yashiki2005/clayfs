#!/bin/sh
# clayfsctl: 作業ディレクトリ (既定 ~/src) の実体をディスクイメージに入れて使うための管理コマンド (macOS)。
#            使い方は git に合わせてある。イメージの中身は 2 つ:
#              work/   作業ツリー。CLAYFS_DIR (~/src) は、ここへのシンボリックリンク
#              store/  コミット (.git にあたる)。work/ のクローンなので、容量は変更された分だけ
#            イメージは CLAYFS_MNT (~/.src.clayfs) にマウントする。クローンはボリュームをまたげないので、
#            コミットは作業ツリーと同じイメージの中に置く必要があり、CLAYFS_DIR の外に出すためにリンクを使う。
#
#   clayfsctl init [SIZE]     CLAYFS_DIR の中身を入れたイメージを作る (既定 30g。使った分だけ大きくなる)。
#                             CLAYFS_DIR には触れない。切り替えは、その後の switch で行う
#   clayfsctl switch          CLAYFS_DIR を CLAYFS_DIR.orig に改名し、イメージの work/ へのリンクに置き換える
#   clayfsctl up              イメージを CLAYFS_MNT にマウントする
#   clayfsctl down [--force]  マウントを外す (--force: 使用中でも強制)。外している間、CLAYFS_DIR は切れたリンクになる
#   clayfsctl exec [-C DIR] CMD...
#                             マウントされていなければマウントしてから、CMD を実行する (LaunchAgent など、
#                             ログイン直後に CLAYFS_DIR の中のものを起動する場合に使う)
#   clayfsctl status [-s]     最後のコミットからの変更 (-s: 1 行ずつ A/M/D)
#   clayfsctl diff [PATH...]  変更の中身 (最後のコミットとの差分)
#   clayfsctl commit [-m MSG] 現状をコミットする (イメージ内のクローンなので速く、容量は変更分だけ)
#   clayfsctl log [-n N]      コミットの一覧
#   clayfsctl show [GEN]      そのコミットの変更一覧と、中身の場所 (省略時は HEAD)
#   clayfsctl restore [--source GEN] PATH...
#                             コミット時の内容に戻す (--all で全体。今の内容は消さずに退避する)
#   clayfsctl gc --keep N     新しい N 個を残して、古いコミットの中身を消す (一覧と変更内容は残る)
#   clayfsctl dedup [--dry-run]
#                             中身が同じファイルをクローンにまとめる (--dry-run: 数えるだけ)
#   clayfsctl scrub           記録したハッシュと中身を照合し、壊れたファイルを報告する
#   clayfsctl rebuild --fresh|--replay [NEWIMAGE]
#                             新しいイメージ (既定 CLAYFS_IMAGE の隣に .new) を作り、圧縮して入れ直す。
#                             今のイメージには触れない。--fresh は履歴なし、--replay は履歴を再現する
#   clayfsctl compact         イメージの空き領域を回収する (down の状態で)
#   clayfsctl info            設定と状態を表示する
#   clayfsctl run             マウントし、変更があればコミットする (自動実行用)
#   clayfsctl install-agent   ログイン時にマウントし、CLAYFS_COMMIT_INTERVAL 秒ごとに自動でコミットする (LaunchAgent)
#   clayfsctl uninstall-agent 自動実行を外す
#
# コミットは HEAD、または名前の一部 (例: 003937) で指定できる。
# 過去のコミットの中身は CLAYFS_MNT/store/layers/コミット名/fs にあり、普通のフォルダとして開ける。
#
# 設定は環境変数、または ~/.config/clayfs/config (シェル形式) で上書きできる:
#   CLAYFS_DIR (~/src)  作業ディレクトリ (イメージの work/ へのリンクになる)
#   CLAYFS_MNT (~/.<DIR の名前>.clayfs)  イメージをマウントする場所
#   CLAYFS_IMAGE (~/<DIR の名前>.dmg.sparsebundle)  イメージ (APFS のスパースバンドル)
#   CLAYFS_COMMIT_INTERVAL (3600)  自動コミットの間隔 (秒)。0 にすると、自動実行はマウントだけを行う
#   CLAYFS_LOG (~/Library/Logs/clayfs.log)
#
# 読めないファイル (開けない、壊れている) は、警告を出して飛ばす。
set -u
HERE="$(cd "$(dirname "$0")" && pwd -P)"
set -a
[ -f "$HOME/.config/clayfs/config" ] && . "$HOME/.config/clayfs/config"
set +a
[ "$(uname -s)" = Darwin ] || { echo "エラー: macOS 専用です (APFS のクローンを使います)" >&2; exit 1; }
CLAYFS_DIR="${CLAYFS_DIR:-$HOME/src}"
CLAYFS_IMAGE="${CLAYFS_IMAGE:-$HOME/$(basename "$CLAYFS_DIR").dmg.sparsebundle}"
CLAYFS_MNT="${CLAYFS_MNT:-$HOME/.$(basename "$CLAYFS_DIR").clayfs}"
CLAYFS_COMMIT_INTERVAL="${CLAYFS_COMMIT_INTERVAL:-3600}"
CLAYFS_LOG="${CLAYFS_LOG:-$HOME/Library/Logs/clayfs.log}"
CLAYFS_TOOL="${CLAYFS_TOOL:-$HERE/clayfs_tool}"
LABEL="top.yashiki.clayfs"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
WORK="$CLAYFS_MNT/work"
STORE="$CLAYFS_MNT/store"
LOCK="$STORE/lock"
UPLOCK="$CLAYFS_MNT.uplock"
ORIG="$CLAYFS_DIR.orig"

die() { echo "エラー: $*" >&2; exit 1; }

# コマンドを実行し、標準出力を捨て、hdiutil の「非推奨」の警告だけ除いて stderr に出す (終了コードは保つ)
quiet() {
  _q_err="$("$@" 2>&1 >/dev/null)"; _q_rc=$?
  [ -n "$_q_err" ] && printf '%s\n' "$_q_err" | grep -v "is deprecated" >&2
  return $_q_rc
}

tool() { "$CLAYFS_TOOL" -s "$STORE" -C "$WORK" "$@"; }

# DIR にボリュームがつながっているか (親とデバイスが違えばマウント点)。mount コマンドは、
# 応答しないマウントが 1 つでもあると固まるので使わない。
is_mounted() {
  [ -d "$1" ] && [ "$(stat -f %d "$1" 2>/dev/null)" != "$(stat -f %d "$1/.." 2>/dev/null)" ]
}
need_up() { is_mounted "$CLAYFS_MNT" || die "マウントされていません: $CLAYFS_MNT (clayfsctl up)"; }

is_empty_dir() { [ -d "$1" ] && [ -z "$(ls -A "$1" 2>/dev/null)" ]; }

attach_at() {  # attach_at DIR: イメージを DIR にマウントする。所有者と権限をそのまま使う
  quiet hdiutil attach -nobrowse -owners on -mountpoint "$1" "$CLAYFS_IMAGE"
}

# 同時に 2 つ動くと、コミットの記録がずれる。mkdir は原子的なので、これを鍵にする。
lock() {
  mkdir -p "$STORE"
  if ! mkdir "$LOCK" 2>/dev/null; then
    _pid="$(cat "$LOCK/pid" 2>/dev/null || true)"
    [ "$_pid" = $$ ] && return 0   # run から commit を呼ぶときなど、自分の鍵
    if [ -n "$_pid" ] && kill -0 "$_pid" 2>/dev/null; then
      die "ほかの clayfsctl が実行中です (PID $_pid)"
    fi
    # 持ち主がもういない鍵 (異常終了の残り) は引き取る
    rm -rf "$LOCK"; mkdir "$LOCK" || die "鍵を取れません: $LOCK"
  fi
  echo $$ >"$LOCK/pid"
  trap 'rm -rf "$LOCK"' EXIT
  trap 'exit 130' INT TERM
}

cmd_init() {
  size="${1:-30g}"
  [ -e "$CLAYFS_IMAGE" ] && die "すでにあります: $CLAYFS_IMAGE"
  [ -d "$CLAYFS_DIR" ] || die "ディレクトリがありません: $CLAYFS_DIR"
  [ -L "$CLAYFS_DIR" ] && die "$CLAYFS_DIR はすでにリンクです (切り替え済み)"
  mkdir -p "$(dirname "$CLAYFS_IMAGE")"
  quiet hdiutil create -size "$size" -type SPARSEBUNDLE -fs APFS -volname "$(basename "$CLAYFS_DIR")" "$CLAYFS_IMAGE" || die "作成に失敗"
  echo "作成しました: $CLAYFS_IMAGE (APFS、$size まで)"
  # いったん別の場所につないで中身を入れる。CLAYFS_DIR は、この間ずっと元のまま使える。
  tmp="$(mktemp -d "$HOME/.clayfs-init.XXXXXX")" || die "作業用の場所を作れません"
  attach_at "$tmp" || { rmdir "$tmp"; die "つなげません: $CLAYFS_IMAGE"; }
  echo "コピーします: $CLAYFS_DIR -> イメージ (数分かかります)"
  STORE="$tmp/store"; WORK="$tmp/work"
  mkdir "$WORK" && tool fill "$CLAYFS_DIR" && tool commit -m "initial"; rc=$?
  # Spotlight に、過去のコミットを 1 つずつ索引させない
  [ -d "$STORE" ] && : >"$STORE/.metadata_never_index"
  quiet hdiutil detach "$tmp" || echo "警告: 外せませんでした: $tmp" >&2
  rmdir "$tmp" 2>/dev/null
  [ $rc = 0 ] || die "取り込みに失敗"
  echo "できました。切り替えるには: clayfsctl switch"
  echo "  (init の後に $CLAYFS_DIR へ加えた変更はイメージに入らないので、続けて実行してください)"
}

# 同時に 2 つがマウントしようとすると (ログイン直後に複数の LaunchAgent が exec を呼ぶ)、片方が失敗する。
# マウントは 1 つずつ行い、待っていた側は、済んでいればそのまま進む。
mount_image() {
  is_mounted "$CLAYFS_MNT" && return 0
  [ -e "$CLAYFS_IMAGE" ] || die "イメージがありません: $CLAYFS_IMAGE (clayfsctl init)"
  _i=0
  while ! mkdir "$UPLOCK" 2>/dev/null; do
    _i=$((_i + 1))
    # 2 分待っても空かなければ、異常終了の残りとみなして引き取る
    [ $_i -gt 120 ] && { rmdir "$UPLOCK" 2>/dev/null; continue; }
    sleep 1
    is_mounted "$CLAYFS_MNT" && return 0
  done
  if ! is_mounted "$CLAYFS_MNT"; then
    mkdir -p "$CLAYFS_MNT"
    is_empty_dir "$CLAYFS_MNT" || { rmdir "$UPLOCK"; die "$CLAYFS_MNT が空ではありません"; }
    attach_at "$CLAYFS_MNT"; _rc=$?
    rmdir "$UPLOCK"
    return $_rc
  fi
  rmdir "$UPLOCK"
}

cmd_switch() {
  [ -e "$CLAYFS_IMAGE" ] || die "イメージがありません: $CLAYFS_IMAGE (clayfsctl init)"
  [ -L "$CLAYFS_DIR" ] && die "すでに切り替え済みです: $CLAYFS_DIR"
  [ -e "$ORIG" ] && die "すでにあります: $ORIG (前回の退避が残っています)"
  mount_image || die "マウントできません: $CLAYFS_IMAGE"
  [ -d "$WORK" ] || die "イメージに work/ がありません: $CLAYFS_IMAGE"
  mv "$CLAYFS_DIR" "$ORIG" || die "改名できません: $CLAYFS_DIR"
  ln -s "$WORK" "$CLAYFS_DIR" || { mv "$ORIG" "$CLAYFS_DIR"; die "リンクを作れません。元に戻しました: $CLAYFS_DIR"; }
  echo "切り替えました: $CLAYFS_DIR -> $WORK (イメージの中)"
  echo "  元の中身   $ORIG (中身を確かめたら、消して構いません)"
  echo "  $CLAYFS_DIR の中のファイルを開いていたプログラムは、$ORIG の側を見続けます。起動し直してください"
}

cmd_up() {
  is_mounted "$CLAYFS_MNT" && { echo "すでにマウントされています: $CLAYFS_MNT"; return 0; }
  mount_image || die "マウントできません: $CLAYFS_IMAGE"
  echo "マウントしました: $CLAYFS_MNT"
  [ -L "$CLAYFS_DIR" ] || echo "  $CLAYFS_DIR はまだリンクではありません (切り替えるには clayfsctl switch)"
}

cmd_down() {
  is_mounted "$CLAYFS_MNT" || { echo "マウントされていません: $CLAYFS_MNT"; return 0; }
  if [ "${1:-}" = --force ]; then
    quiet hdiutil detach -force "$CLAYFS_MNT" || die "外せません: $CLAYFS_MNT"
  else
    quiet hdiutil detach "$CLAYFS_MNT" || die "使用中で外せません: $CLAYFS_MNT (開いているファイルやターミナルを閉じるか、--force)"
  fi
  rmdir "$CLAYFS_MNT" 2>/dev/null
  echo "外しました: $CLAYFS_MNT"
}

cmd_exec() {  # マウントを確かめてから CMD に置き換わる。標準出力には何も足さない
  dir=""
  if [ "${1:-}" = -C ]; then dir="${2:-}"; shift 2 || die "使い方: clayfsctl exec [-C DIR] CMD..."; fi
  [ $# -ge 1 ] || die "使い方: clayfsctl exec [-C DIR] CMD..."
  mount_image || die "マウントできません: $CLAYFS_IMAGE"
  if [ -n "$dir" ]; then cd "$dir" || die "移動できません: $dir"; fi
  exec "$@"
}

cmd_status() { need_up; tool status "$@"; }
cmd_diff() { need_up; tool diff "$@"; }
cmd_log() { need_up; tool log "$@"; }
cmd_show() { need_up; tool show "$@"; }
cmd_commit() { need_up; lock; tool commit "$@"; }
cmd_gc() { need_up; lock; tool gc "$@"; }
cmd_dedup() { need_up; lock; tool dedup "$@"; }
cmd_scrub() { need_up; lock; tool scrub; }

cmd_rebuild() {
  case "${1:-}" in --fresh) mode=fresh ;; --replay) mode=replay ;; *) die "使い方: clayfsctl rebuild --fresh|--replay [NEWIMAGE]" ;; esac
  new="${2:-${CLAYFS_IMAGE%.sparsebundle}.new.sparsebundle}"
  need_up
  [ -e "$new" ] && die "すでにあります: $new"
  lock
  size="$(hdiutil imageinfo "$CLAYFS_IMAGE" 2>/dev/null | awk '/Total Bytes/ {print $3; exit}')"
  quiet hdiutil create -size "$(( ${size:-32212254720} / 1048576 ))m" -type SPARSEBUNDLE -fs APFS -volname "$(basename "$CLAYFS_DIR")" "$new" || die "作成に失敗: $new"
  tmp="$(mktemp -d "$HOME/.clayfs-rebuild.XXXXXX")" || die "作業用の場所を作れません"
  quiet hdiutil attach -nobrowse -owners on -mountpoint "$tmp" "$new" || { rmdir "$tmp"; die "つなげません: $new"; }
  tool rebuild-into "$tmp" --mode "$mode"; rc=$?
  [ -d "$tmp/store" ] && : >"$tmp/store/.metadata_never_index"
  quiet hdiutil detach "$tmp" || echo "警告: 外せませんでした: $tmp" >&2
  rmdir "$tmp" 2>/dev/null
  [ $rc = 0 ] || die "入れ直しに失敗 (作りかけ: $new)"
  echo "できました: $new ($(du -sh "$new" | cut -f1 | tr -d ' '))"
}

cmd_restore() {
  [ $# -ge 1 ] || die "使い方: clayfsctl restore [--source コミット] PATH... (全体を戻すなら --all)"
  need_up
  lock
  tool restore "$@"
}

cmd_compact() {
  [ -e "$CLAYFS_IMAGE" ] || die "イメージがありません: $CLAYFS_IMAGE"
  is_mounted "$CLAYFS_MNT" && die "マウント中は回収できません。先に clayfsctl down"
  before="$(du -sk "$CLAYFS_IMAGE" | cut -f1)"
  quiet hdiutil compact "$CLAYFS_IMAGE" || echo "警告: 回収に失敗しました" >&2
  after="$(du -sk "$CLAYFS_IMAGE" | cut -f1)"
  echo "回収しました: $(( (before - after) / 1024 )) MB (現在 $(( after / 1024 )) MB)"
}

cmd_info() {
  echo "対象     $CLAYFS_DIR $([ -L "$CLAYFS_DIR" ] && echo "-> $(readlink "$CLAYFS_DIR")" || echo "(まだ切り替えていません)")"
  echo "マウント $CLAYFS_MNT $(is_mounted "$CLAYFS_MNT" && echo "(マウント中)" || echo "(マウントされていません)")"
  echo "イメージ $CLAYFS_IMAGE$([ -e "$CLAYFS_IMAGE" ] && echo " ($(du -sh "$CLAYFS_IMAGE" | cut -f1 | tr -d ' '))" || echo " (まだありません。clayfsctl init)")"
  if is_mounted "$CLAYFS_MNT" && [ -f "$STORE/work.json" ]; then
    echo "HEAD     $(sed -n 's/.*"base": "\([^"]*\)".*/\1/p' "$STORE/work.json")"
    echo "コミット $(wc -l <"$STORE/log.jsonl" | tr -d ' ') 個 ($STORE)"
  fi
  [ -e "$ORIG" ] && echo "退避     $ORIG ($(du -sh "$ORIG" | cut -f1 | tr -d ' ')。確かめたら消せます)"
  if [ -f "$PLIST" ]; then echo "自動実行 あり (ログ: $CLAYFS_LOG)"; else echo "自動実行 なし (clayfsctl install-agent)"; fi
}

cmd_run() {  # launchd 用: マウントし、変更があればコミットする
  mount_image || die "マウントできません: $CLAYFS_IMAGE"
  [ "$CLAYFS_COMMIT_INTERVAL" = 0 ] && return 0
  [ -f "$STORE/work.json" ] || return 0
  if ! tool status -q; then
    echo "$(date '+%F %T') 変更があるのでコミットします"
    cmd_commit -m "auto"
  fi
}

xesc() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }

cmd_install_agent() {
  [ -e "$CLAYFS_IMAGE" ] || die "イメージがありません: $CLAYFS_IMAGE (clayfsctl init)"
  case "$CLAYFS_COMMIT_INTERVAL" in ''|*[!0-9]*) die "CLAYFS_COMMIT_INTERVAL は秒数 (整数) で指定してください: $CLAYFS_COMMIT_INTERVAL" ;; esac
  interval=""
  if [ "$CLAYFS_COMMIT_INTERVAL" != 0 ]; then
    [ "$CLAYFS_COMMIT_INTERVAL" -ge 60 ] || die "CLAYFS_COMMIT_INTERVAL は 60 以上 (または 0) にしてください: $CLAYFS_COMMIT_INTERVAL"
    interval="  <key>StartInterval</key><integer>$CLAYFS_COMMIT_INTERVAL</integer>"
  fi
  mkdir -p "$(dirname "$PLIST")" "$(dirname "$CLAYFS_LOG")"
  cat >"$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>$(xesc "$HERE")/clayfsctl</string><string>run</string></array>
  <key>EnvironmentVariables</key><dict>
    <key>CLAYFS_DIR</key><string>$(xesc "$CLAYFS_DIR")</string>
    <key>CLAYFS_IMAGE</key><string>$(xesc "$CLAYFS_IMAGE")</string>
    <key>CLAYFS_MNT</key><string>$(xesc "$CLAYFS_MNT")</string>
    <key>CLAYFS_COMMIT_INTERVAL</key><string>$CLAYFS_COMMIT_INTERVAL</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
$interval
  <key>StandardOutPath</key><string>$(xesc "$CLAYFS_LOG")</string>
  <key>StandardErrorPath</key><string>$(xesc "$CLAYFS_LOG")</string>
</dict></plist>
EOF
  launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null
  launchctl bootstrap "gui/$(id -u)" "$PLIST" || { rm -f "$PLIST"; die "LaunchAgent を読み込めません"; }
  if [ -n "$interval" ]; then
    echo "入れました: $PLIST (ログイン時にマウントし、$CLAYFS_COMMIT_INTERVAL 秒ごとに、変更があればコミットします)"
  else
    echo "入れました: $PLIST (ログイン時にマウントします)"
  fi
}

cmd_uninstall_agent() {
  launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null
  if [ -f "$PLIST" ]; then rm -f "$PLIST"; echo "外しました: $PLIST"; else echo "入っていません"; fi
}

cmd="${1:-}"; [ $# -gt 0 ] && shift
case "$cmd" in
  init) cmd_init "$@" ;;
  switch) cmd_switch ;;
  up) cmd_up ;;
  down) cmd_down "$@" ;;
  exec) cmd_exec "$@" ;;
  status) cmd_status "$@" ;;
  diff) cmd_diff "$@" ;;
  commit) cmd_commit "$@" ;;
  log) cmd_log "$@" ;;
  show) cmd_show "$@" ;;
  restore) cmd_restore "$@" ;;
  gc) cmd_gc "$@" ;;
  dedup) cmd_dedup "$@" ;;
  scrub) cmd_scrub ;;
  rebuild) cmd_rebuild "$@" ;;
  compact) cmd_compact ;;
  info) cmd_info ;;
  run) cmd_run ;;
  install-agent) cmd_install_agent ;;
  uninstall-agent) cmd_uninstall_agent ;;
  *) sed -n '2,/^set -u/p' "$0" | sed -e '$d' -e 's/^# \{0,1\}//'; exit 1 ;;
esac
