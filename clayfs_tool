import sys
import tarfile
import time

WH = '.wh.'
OPQ = '.wh..wh..opq'

_libc = ctypes.CDLL(None, use_errno=True)
_libc.clonefile.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_uint32]


def die(msg):
    sys.exit(f'エラー: {msg}')


def write_atomic(path, text):
    """path を、一時ファイルに書いてから改名で差し替える。途中で止まっても、古い内容か新しい内容のどちらかが残る。"""
    tmp = f'{path}.tmp.{os.getpid()}'
    try:
        with open(tmp, 'w', encoding='utf-8') as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def load_json(path, default=None):
    """JSON を読む。無ければ default。壊れていれば、何が壊れているかを示して止まる (例外の表示で終わらせない)。"""
    try:
        with open(path, encoding='utf-8') as f:
            return json.load(f)
    except FileNotFoundError:
        return default
    except ValueError as e:
        die(f'{path} が壊れています ({e})。別の場所のコピーから戻すか、消してください')


_libc.copyfile.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_void_p, ctypes.c_uint32]
COPYFILE_ALL = 0xf          # ACL | STAT | XATTR | DATA
COPYFILE_METADATA = 0x7     # ACL | STAT | XATTR
COPYFILE_NOFOLLOW = 0xc0000
COPYFILE_RECURSIVE = 1 << 15


def copy(src, dst, flags):
    """copyfile(3): keeps xattrs, resource forks, ACLs, BSD flags and all timestamps."""
    if _libc.copyfile(os.fsencode(src), os.fsencode(dst), None, flags | COPYFILE_NOFOLLOW):
        die(f'cannot copy {src} to {dst}: {os.strerror(ctypes.get_errno())}')


def _clone(src, dst):
    return _libc.clonefile(os.fsencode(src), os.fsencode(dst), 0) == 0


def force_rmtree(path):
    """変更禁止の印 (uchg) や、書き込めない・読めないディレクトリがあっても、ツリーごと消す。
    ふつうの rmtree は、これらで PermissionError になり、半分消えた状態で止まる。"""
    def unlock(p):
        try:
            os.chflags(p, 0, follow_symlinks=False)
        except (OSError, NotImplementedError):
            pass
    unlock(path)
    for root, dirs, files in os.walk(path, topdown=True, followlinks=False):
        try:
            os.chmod(root, 0o700)
        except OSError:
            pass
        for n in dirs + files:
            q = os.path.join(root, n)
            unlock(q)
            if n in dirs and not os.path.islink(q):
                try:
                    os.chmod(q, 0o700)
                except OSError:
                    pass
    shutil.rmtree(path)


def clone_tree(src, dst, bad=None):
    """Clone a directory hierarchy, one syscall per subtree where the kernel allows it.

    Some files cannot be cloned (seen: a database held open by a running
    service). Those are copied for real, and their paths are added to `bad`
    so the next call does not waste a whole-tree attempt on them.
    """
    bad = set() if bad is None else bad
    doomed = any(b == src or b.startswith(src + '/') for b in bad)
    if not doomed and _clone(src, dst):
        return
    err = ctypes.get_errno()
    if os.path.isdir(dst) and not os.path.islink(dst):
        shutil.rmtree(dst)

    if os.path.isdir(src) and not os.path.islink(src):
        os.mkdir(dst)
        try:
            with os.scandir(src) as it:
                entries = list(it)
        except OSError as e:
            # 読めないディレクトリ: 中身は複製できない。空のディレクトリだけ残して続ける (全体を落とさない)
            bad.add(src)
            print(f'警告: 読めないため中身を飛ばしました: {src} ({e.strerror})', file=sys.stderr)
            entries = []
        for e in entries:
            clone_tree(e.path, os.path.join(dst, e.name), bad)
        _libc.copyfile(os.fsencode(src), os.fsencode(dst), None, COPYFILE_METADATA | COPYFILE_NOFOLLOW)
        return
    bad.add(src)
    if _libc.copyfile(os.fsencode(src), os.fsencode(dst), None, COPYFILE_ALL | COPYFILE_NOFOLLOW):
        # not even readable: leave it out rather than fail the whole snapshot
        if os.path.lexists(dst):
            os.unlink(dst)
        print(f'警告: 読めないため飛ばしました: {src} ({os.strerror(ctypes.get_errno())})', file=sys.stderr)


class Store:
    def __init__(self, root):
        self.root = os.path.realpath(os.path.expanduser(root))
        self.layers = os.path.join(self.root, 'layers')
        os.makedirs(self.layers, exist_ok=True)

    def dir(self, name):
        if not name or '/' in name or name.startswith('.'):
            die(f'bad layer name: {name!r}')
        return os.path.join(self.layers, name)

    def fs(self, name):
        return os.path.join(self.dir(name), 'fs')

    def meta(self, name):
        m = load_json(os.path.join(self.dir(name), 'meta.json'))
        if m is None:
            die(f'no such layer: {name}')
        return m

    def write_meta(self, name, meta):
        write_atomic(os.path.join(self.dir(name), 'meta.json'), json.dumps(meta))

    def names(self):
        return sorted(n for n in os.listdir(self.layers) if not n.startswith('.'))

    def create(self, name, src, parent, bad=None):
        """New layer whose tree is a clone of src."""
        d = self.dir(name)
        if os.path.exists(d):
            die(f'layer exists: {name}')
        # build under a hidden name so a failed clone never looks like a layer
        tmp = os.path.join(self.layers, f'.tmp.{os.getpid()}.{name}')
        started = time.time()
        os.mkdir(tmp)
        try:
            clone_tree(src, os.path.join(tmp, 'fs'), bad)
        except BaseException:
            shutil.rmtree(tmp, ignore_errors=True)
            raise
        os.rename(tmp, d)
        self.write_meta(name, {'parent': parent, 'committed': False, 'started': started, 'created': time.time()})


def cmd_import(st, a):
    if not os.path.isdir(a.dir):
        die(f'not a directory: {a.dir}')
    st.create(a.name, a.dir, None)
    m = st.meta(a.name)
    m['committed'] = True
    st.write_meta(a.name, m)


def cmd_prepare(st, a):
    if not st.meta(a.parent)['committed']:
        die(f'parent is not committed: {a.parent}')
    st.create(a.name, st.fs(a.parent), a.parent)
    print(st.fs(a.name))


def cmd_commit(st, a):
    m = st.meta(a.name)
    m['committed'] = True
    st.write_meta(a.name, m)


def cmd_path(st, a):
    st.meta(a.name)
    print(st.fs(a.name))


def cmd_ls(st, a):
    for n in st.names():
        m = st.meta(n)
        print(f"{n}\t{m['parent'] or '-'}\t{'committed' if m['committed'] else 'active'}")


def cmd_rm(st, a):
    st.meta(a.name)
    kids = [n for n in st.names() if st.meta(n)['parent'] == a.name]
    if kids and not a.force:
        die(f'{a.name} is the parent of: {" ".join(kids)} (use -f; children keep working, they hold their own clones)')
    force_rmtree(st.dir(a.name))


def same(a, b):
    """True if two lstat results describe an unchanged clone of the same entry."""
    if stat.S_IFMT(a.st_mode) != stat.S_IFMT(b.st_mode):
        return False
    if (a.st_mode, a.st_uid, a.st_gid) != (b.st_mode, b.st_uid, b.st_gid):
        return False
    if stat.S_ISDIR(a.st_mode):
        return True
    return a.st_size == b.st_size and a.st_mtime_ns == b.st_mtime_ns


def scan(d):
    try:
        with os.scandir(d) as it:
            return {e.name: e.stat(follow_symlinks=False) for e in it}
    except FileNotFoundError:
        return {}


def diff_tree(tar, old, new, rel=''):
    """Write what turns old into new, with OCI whiteouts for removals."""
    try:
        o, n = scan(os.path.join(old, rel)), scan(os.path.join(new, rel))
    except PermissionError as e:
        print(f'警告: 読めないため比べられません: {e.filename}', file=sys.stderr)
        return
    for name in sorted(o.keys() - n.keys()):
        ti = tarfile.TarInfo(os.path.join(rel, WH + name))
        tar.addfile(ti)
    for name in sorted(n):
        p = os.path.join(rel, name)
        full = os.path.join(new, p)
        os_, ns = o.get(name), n[name]
        isdir = stat.S_ISDIR(ns.st_mode)
        if os_ is None or not same(os_, ns):
            tar.add(full, arcname=p, recursive=False)
            if isdir and os_ is not None and not stat.S_ISDIR(os_.st_mode):
                os_ = None
        if isdir:
            if os_ is None:
                # brand new directory: everything below is new as well
                for sub in sorted(os.listdir(full)):
                    tar.add(os.path.join(full, sub), arcname=os.path.join(p, sub))
            else:
                diff_tree(tar, old, new, p)


def cmd_diff(st, a):
    m = st.meta(a.name)
    if not m['parent']:
        die(f'{a.name} has no parent')
    st.meta(m['parent'])
    out = open(a.output, 'wb') if a.output else sys.stdout.buffer
    with tarfile.open(fileobj=out, mode='w|', format=tarfile.PAX_FORMAT) as tar:
        diff_tree(tar, st.fs(m['parent']), st.fs(a.name))
    if a.output:
        out.close()


def remove(path):
    if os.path.isdir(path) and not os.path.islink(path):
        shutil.rmtree(path)
    elif os.path.lexists(path):
        os.unlink(path)


def inside_root(root, parent):
    """root の下の parent (相対) の実体が、root の中にあるか。途中にシンボリックリンクがあって外を指していれば False。"""
    rr = os.path.realpath(root)
    rp = os.path.realpath(os.path.join(root, parent))
    return rp == rr or rp.startswith(rr + os.sep)


def apply_tar(root, tarpath):
    with tarfile.open(tarpath) as tar:
        for m in tar:
            name = os.path.normpath(m.name)
            if name.startswith(('/', '..')):
                die(f'unsafe path in layer: {m.name}')
            d, base = os.path.split(name)
            # 親の途中にある、外を指すシンボリックリンクを通って、レイヤーの外のファイルを消したり書いたりしない
            if not inside_root(root, d):
                die(f'unsafe path in layer (リンクがレイヤーの外を指しています): {m.name}')
            if base == OPQ:
                parent = os.path.join(root, d)
                if os.path.isdir(parent) and not os.path.islink(parent):
                    for e in os.listdir(parent):
                        remove(os.path.join(parent, e))
                continue
            if base.startswith(WH):
                remove(os.path.join(root, d, base[len(WH):]))
                continue
            dst = os.path.join(root, name)
            if os.path.lexists(dst) and not (m.isdir() and os.path.isdir(dst) and not os.path.islink(dst)):
                remove(dst)
            tar.extract(m, root, filter='tar')


def cmd_apply(st, a):
    cmd_prepare(st, a)
    apply_tar(st.fs(a.name), a.tar)
    cmd_commit(st, a)


# ---------- 作業ツリー ----------

STORE_NAME = '.clayfs'
# ボリュームの直下にある、コミットに含めないもの (ストア自身と、macOS がボリュームごとに持つ管理用)
EXCLUDE = {STORE_NAME, '.fseventsd', '.Spotlight-V100', '.Trashes', '.TemporaryItems', '.DocumentRevisions-V100'}
# どの階層にあっても、コミットにも差分にも入れない生成物 (Python のバイトコード)。消えても再生成される
PRUNE = {'__pycache__'}
LABEL = {'A': '追加', 'M': '変更', 'D': '削除'}


WORK_DIR = None   # -C で指定された作業ディレクトリ


def work_dir(st):
    if WORK_DIR:
        return WORK_DIR
    if os.path.basename(st.root) != STORE_NAME:
        die('作業ディレクトリを -C で指定してください')
    return os.path.dirname(st.root)


def work_conf(st):
    return load_json(os.path.join(st.root, 'work.json'), {'base': None})


def save_work_conf(st, conf):
    write_atomic(os.path.join(st.root, 'work.json'), json.dumps(conf, indent=1))


def need_base(conf):
    if not conf.get('base'):
        die('まだコミットがありません (clayfsctl commit)')
    return conf['base']


def top_entries(d):
    return sorted(n for n in os.listdir(d) if n not in EXCLUDE)


def strip_pruned(root):
    """複製したコミットの中から、PRUNE の名前のフォルダを取り除く。作業ツリーの側は触らない。"""
    stack = [root]
    while stack:
        d = stack.pop()
        with os.scandir(d) as it:
            for e in it:
                if not e.is_dir(follow_symlinks=False):
                    continue
                if e.name in PRUNE:
                    shutil.rmtree(e.path)
                else:
                    stack.append(e.path)


def copy_tree(src, dst):
    """Copy a subtree with all metadata; whatever cannot be read is skipped with a warning."""
    if _libc.copyfile(os.fsencode(src), os.fsencode(dst), None,
                      COPYFILE_ALL | COPYFILE_RECURSIVE | COPYFILE_NOFOLLOW) == 0:
        return 0
    err = ctypes.get_errno()
    remove(dst)
    if os.path.isdir(src) and not os.path.islink(src):
        # 丸ごとは失敗した: 読めないものだけを飛ばせるよう、1 段ずつ降りる
        os.mkdir(dst)
        n = 0
        with os.scandir(src) as it:
            for e in it:
                n += copy_tree(e.path, os.path.join(dst, e.name))
        _libc.copyfile(os.fsencode(src), os.fsencode(dst), None, COPYFILE_METADATA | COPYFILE_NOFOLLOW)
        return n
    print(f'警告: 読めないため飛ばしました: {src} ({os.strerror(err)})', file=sys.stderr)
    return 1


def cmd_fill(st, a):
    d = work_dir(st)
    src = os.path.realpath(os.path.expanduser(a.src))
    if not os.path.isdir(src):
        die(f'ディレクトリではありません: {src}')
    if top_entries(d):
        die(f'コピー先が空ではありません: {d}')
    skipped = 0
    for n in top_entries(src):
        skipped += copy_tree(os.path.join(src, n), os.path.join(d, n))
    print(f'コピーしました: {src} -> {d}' + (f' (読めなかった {skipped} 件を除く)' if skipped else ''))


def snapshot(st, conf, name=None):
    """Clone everything in the working directory into a new layer; returns its name."""
    d = work_dir(st)
    explicit = name is not None
    name = name or time.strftime('base-%Y%m%d-%H%M%S')
    if os.path.exists(st.dir(name)):
        if explicit:
            die(f'同じ名前のコミットがあります: {name}')
        # 同じ秒に 2 回目: 連番を付ける (スクリプトから続けて呼んでも失敗しない)
        n = 2
        while os.path.exists(st.dir(f'{name}-{n}')):
            n += 1
        name = f'{name}-{n}'

    bad = {os.path.join(d, p) for p in conf.get('noclone', [])}
    tmp = os.path.join(st.layers, f'.tmp.{os.getpid()}.{name}')
    started = time.time()
    os.makedirs(tmp)
    try:
        if os.path.commonpath([d, st.root]) == d:
            # ストアが対象の中にあるので、全体を 1 回では複製できない。直下の項目ごとに複製する
            os.mkdir(os.path.join(tmp, 'fs'))
            for n in top_entries(d):
                clone_tree(os.path.join(d, n), os.path.join(tmp, 'fs', n), bad)
        else:
            clone_tree(d, os.path.join(tmp, 'fs'), bad)
        strip_pruned(os.path.join(tmp, 'fs'))
    except BaseException:
        shutil.rmtree(tmp, ignore_errors=True)
        raise
    os.rename(tmp, st.dir(name))
    st.write_meta(name, {'parent': conf.get('base'), 'committed': True, 'started': started, 'created': time.time()})
    conf['noclone'] = sorted(os.path.relpath(p, d) for p in bad if os.path.lexists(p))
    # 複製できず、コミットに入らなかったもの。status と commit は相手にしない
    conf['skipped'] = [p for p in conf['noclone'] if not os.path.lexists(os.path.join(st.fs(name), p))]
    return name


_libc.listxattr.restype = _libc.getxattr.restype = ctypes.c_ssize_t
_libc.listxattr.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_size_t, ctypes.c_int]
_libc.getxattr.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_char_p, ctypes.c_size_t, ctypes.c_uint32, ctypes.c_int]
_libc.setxattr.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_char_p, ctypes.c_size_t, ctypes.c_uint32, ctypes.c_int]
_libc.removexattr.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_int]
XATTR_NOFOLLOW = 1

UF_COMPRESSED = 0x20
IMMUTABLE = 0x2 | 0x20000          # UF_IMMUTABLE | SF_IMMUTABLE
COMPRESSION_XATTRS = (b'com.apple.decmpfs', b'com.apple.ResourceFork')


def has_real_rsrc(path, flags):
    """透過圧縮の入れ物ではない、本物のリソースフォークを持つか。
    リソースフォークは com.apple.ResourceFork という拡張属性で、圧縮済み (UF_COMPRESSED) のファイルでは圧縮データの置き場でもある。
    圧縮済みでないのに持っていれば本物で、クローンや ditto で差し替えると中身を失うので、dedup と compress は触らない。"""
    if flags & UF_COMPRESSED:
        return False
    return _libc.getxattr(os.fsencode(path), b'com.apple.ResourceFork', None, 0, 0, XATTR_NOFOLLOW) >= 0


def xattrs(path):
    """All extended attributes of path itself (not a symlink's target), or None if unreadable."""
    p = os.fsencode(path)
    n = _libc.listxattr(p, None, 0, XATTR_NOFOLLOW)
    if n <= 0:
        return {} if n == 0 else None
    buf = ctypes.create_string_buffer(n)
    n = _libc.listxattr(p, buf, n, XATTR_NOFOLLOW)
    out = {}
    for name in buf.raw[:max(n, 0)].split(b'\0'):
        if not name:
            continue
        size = _libc.getxattr(p, name, None, 0, 0, XATTR_NOFOLLOW)
        val = ctypes.create_string_buffer(max(size, 1))
        size = _libc.getxattr(p, name, val, max(size, 0), 0, XATTR_NOFOLLOW)
        out[name] = val.raw[:max(size, 0)]
    return out


def user_xattrs(path):
    x = xattrs(path)
    if x is None:
        return None
    return {k: v for k, v in x.items() if k not in COMPRESSION_XATTRS}


def touched(a, b, old, new, since):
    """Same size and times, but changed after the commit: look at what else can differ.

    ctime also moves when a file is merely restored, so compare flags and
    extended attributes (code signatures live there) before calling it changed.
    """
    if not since or b.st_ctime <= since:
        return False
    # UF_TRACKED (0x40) は OS が付け外しする印。UF_COMPRESSED (0x20) も透過圧縮の印。変更とはみなさない
    ignore_flags = 0x40 | UF_COMPRESSED
    return (a.st_flags & ~ignore_flags) != (b.st_flags & ~ignore_flags) or user_xattrs(old) != user_xattrs(new)


def changes(old, new, rel='', since=None):
    """Yield (kind, path) for added, modified and deleted entries.

    `since` is when `old` was cloned from `new`: anything whose ctime is later
    was touched, which also catches xattr-only changes such as code signing.
    """
    try:
        o, n = scan(os.path.join(old, rel)), scan(os.path.join(new, rel))
    except PermissionError as e:
        # 読めないディレクトリは比べられない。中身が消えたと誤って報告しないよう、変更なしとして飛ばす
        print(f'警告: 読めないため比べられません: {e.filename}', file=sys.stderr)
        return
    for name in sorted(o.keys() | n.keys()):
        if (not rel and name in EXCLUDE) or name in PRUNE:
            continue
        p = os.path.join(rel, name)
        a, b = o.get(name), n.get(name)
        if b is None:
            yield 'D', p
        elif a is None:
            yield 'A', p + ('/' if stat.S_ISDIR(b.st_mode) else '')
        elif stat.S_ISDIR(a.st_mode) and stat.S_ISDIR(b.st_mode):
            if not same(a, b):
                yield 'M', p + '/'
            yield from changes(old, new, p, since)
        elif not same(a, b) or touched(a, b, os.path.join(old, p), os.path.join(new, p), since):
            yield 'M', p


def work_changes(st, conf):
    base = need_base(conf)
    skipped = set(conf.get('skipped', []))
    return (c for c in changes(st.fs(base), work_dir(st), since=st.meta(base).get('started'))
            if c[1] not in skipped)


def visible(notes):
    """Drop directory-only entries: a directory's times change whenever something inside does."""
    return [(k, p) for k, p in notes if not (k == 'M' and p.endswith('/'))]


# ---- コミットの記録 ----
# gc でコミットの中身を消しても、一覧と変更内容は残す:
#   log.jsonl            1 行 1 コミット (古い順)
#   changes/GEN.changes  そのコミットの変更一覧

def log_entries(st):
    out = []
    try:
        with open(os.path.join(st.root, 'log.jsonl'), encoding='utf-8') as f:
            for line in f:
                if not line.strip():
                    continue
                try:
                    out.append(json.loads(line))
                except ValueError:
                    # 書いている途中で止まった行。読み飛ばす (これだけで全部のコマンドが止まるのを避ける)
                    print('警告: log.jsonl の壊れた行を飛ばしました', file=sys.stderr)
    except FileNotFoundError:
        pass
    return out


def quote_path(p):
    """変更一覧は 1 行 1 件なので、改行とバックスラッシュをエスケープして書く。"""
    return p.replace('\\', '\\\\').replace('\n', '\\n').replace('\r', '\\r')


def unquote_path(p):
    out, i = [], 0
    while i < len(p):
        if p[i] == '\\' and i + 1 < len(p) and p[i + 1] in '\\nr':
            out.append({'\\': '\\', 'n': '\n', 'r': '\r'}[p[i + 1]])
            i += 2
        else:
            out.append(p[i])
            i += 1
    return ''.join(out)


def changes_file(st, name):
    return os.path.join(st.root, 'changes', name + '.changes')


def record(st, name, msg, notes, when=None):
    os.makedirs(os.path.join(st.root, 'changes'), exist_ok=True)
    write_atomic(changes_file(st, name), f'# {name} {msg or ""}\n' + ''.join(f'{k} {quote_path(p)}\n' for k, p in notes))
    line = json.dumps({'name': name, 'message': msg or '', 'time': when or time.time(), 'changes': len(notes)}, ensure_ascii=False) + '\n'
    fd = os.open(os.path.join(st.root, 'log.jsonl'), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
    try:
        # 前の行が途中で止まっていても、この行が巻き込まれないよう、改行で終わっていなければ足す
        size = os.fstat(fd).st_size
        if size:
            with open(os.path.join(st.root, 'log.jsonl'), 'rb') as r:
                r.seek(size - 1)
                if r.read(1) != b'\n':
                    line = '\n' + line
        os.write(fd, line.encode('utf-8'))
        os.fsync(fd)
    finally:
        os.close(fd)


def resolve_gen(st, conf, spec):
    if spec in (None, 'HEAD'):
        return need_base(conf)
    names = [e['name'] for e in log_entries(st)]
    if spec in names:
        return spec
    hits = [n for n in names if spec in n]
    if len(hits) != 1:
        die(f'その名前のコミットは{"ありません" if not hits else "複数あります"}: {spec}')
    return hits[0]


def rel_to(d, p):
    """Path of p relative to the working directory, with symlinked parents (/tmp) resolved."""
    p = os.path.abspath(p)
    return os.path.relpath(os.path.join(os.path.realpath(os.path.dirname(p)), os.path.basename(p)), d)


def cmd_status(st, a):
    conf = work_conf(st)
    notes = visible(work_changes(st, conf))
    if a.quiet:
        sys.exit(1 if notes else 0)
    if a.short:
        for kind, p in notes:
            print(kind, p)
        return
    print(f'HEAD {conf["base"]}')
    if notes:
        print('\nコミットしていない変更:')
        for kind, p in notes:
            print(f'\t{LABEL[kind]}:   {p}')
        print('\n(clayfsctl commit でコミット、clayfsctl restore PATH で取り消し)')
    else:
        print('\n変更はありません')
    for p in conf.get('skipped', []):
        print(f'複製できないため対象外: {p}')


def cmd_wdiff(st, a):
    conf = work_conf(st)
    base, d = st.fs(need_base(conf)), work_dir(st)
    want = [rel_to(d, p) for p in a.paths]
    for kind, p in visible(work_changes(st, conf)):
        rel = p.rstrip('/')
        if want and not any(rel == w or rel.startswith(w + '/') or w == '.' for w in want):
            continue
        old, new = os.path.join(base, rel), os.path.join(d, rel)
        sys.stdout.flush()
        if kind == 'D' or os.path.isdir(new) or os.path.isdir(old):
            print(f'{LABEL[kind]}: {p}')
            continue
        subprocess.run(['diff', '-u', '-N', '--label', 'a/' + rel, '--label', 'b/' + rel,
                        old if kind == 'M' else '/dev/null', new])


def cmd_wcommit(st, a):
    conf = work_conf(st)
    first = not conf.get('base')
    if not first and not a.allow_empty and not visible(work_changes(st, conf)):
        print('変更はありません (コミットしません)')
        return
    name = snapshot(st, conf)
    # 複製した後で数える: その間に触られたファイルは余分に載るだけで、漏れない
    work_changes_all = [] if first else list(work_changes(st, conf))
    notes = visible(work_changes_all)
    record(st, name, a.message, notes)
    conf['base'] = name
    save_work_conf(st, conf)
    # 変わったファイルのハッシュを記録する (dedup と scrub が使う)
    if os.path.exists(os.path.join(st.root, 'index.sqlite')):
        index_changes(st, work_changes_all)
        record_versions(st, name, work_changes_all)
    print(f'[{name}] {a.message or ""}\n {len(notes)} 件の変更')


def restore_one(st, gen, rel, trash):
    d = work_dir(st)
    cur, src = os.path.join(d, rel), os.path.join(st.fs(gen), rel)
    if os.path.lexists(cur):
        # 今の内容は消さずに退避する
        keep = os.path.join(trash, rel)
        os.makedirs(os.path.dirname(keep), exist_ok=True)
        os.rename(cur, keep)
    if os.path.lexists(src):
        os.makedirs(os.path.dirname(cur), exist_ok=True)
        clone_tree(src, cur)
        print(f'戻しました: {rel} ({gen})')
    else:
        print(f'{gen} の時点にはありません: {rel}')


def cmd_restore(st, a):
    conf = work_conf(st)
    gen = resolve_gen(st, conf, a.source)
    if not os.path.isdir(st.dir(gen)):
        die(f'{gen} の中身は gc で消されています')
    d = work_dir(st)
    if a.all == bool(a.paths):
        die('戻すパスを指定してください (全体を戻すなら --all)')
    if a.all:
        # マウント点そのものは動かせないので、直下の項目を 1 つずつ戻す
        rels = sorted(set(top_entries(d)) | set(top_entries(st.fs(gen))))
    else:
        rels = [os.path.normpath(rel_to(d, p)) for p in a.paths]
    trash = os.path.join(st.root, 'trash', time.strftime('%Y%m%d-%H%M%S'))
    for rel in rels:
        if rel.startswith('..') or rel == '.' or rel.split(os.sep)[0] in EXCLUDE:
            die(f'戻せるのは {d} の中のものだけです: {rel}')
        restore_one(st, gen, rel, trash)
    if os.path.isdir(trash):
        print(f'戻す前の内容は、ここに退避してあります: {trash}')


def cmd_log(st, a):
    conf = work_conf(st)
    entries = list(reversed(log_entries(st)))
    for e in entries[:a.n] if a.n else entries:
        marks = [m for m, on in (('HEAD', e['name'] == conf.get('base')),
                                 ('中身なし', not os.path.isdir(st.dir(e['name'])))) if on]
        when = time.strftime('%Y-%m-%d %H:%M', time.localtime(e['time']))
        print(f'{e["name"]}{" (" + ", ".join(marks) + ")" if marks else ""}  {when}  {e["changes"]} 件  {e["message"]}')


def cmd_show(st, a):
    gen = resolve_gen(st, work_conf(st), a.gen)
    with open(changes_file(st, gen)) as h:
        sys.stdout.write(h.read())
    if os.path.isdir(st.dir(gen)):
        print(f'中身: {st.fs(gen)}')


def trash_report(st, days):
    """restore が退避した内容 (STORE/trash/日時) を数える。days > 0 なら、それより古いものを消す。"""
    root = os.path.join(st.root, 'trash')
    if not os.path.isdir(root):
        return
    n = old = 0
    limit = time.time() - days * 86400
    for name in sorted(os.listdir(root)):
        path = os.path.join(root, name)
        try:
            when = time.mktime(time.strptime(name, '%Y%m%d-%H%M%S'))
        except ValueError:
            continue
        n += 1
        if days > 0 and when < limit:
            try:
                force_rmtree(path)
                old += 1
            except OSError as e:
                print(f'消せませんでした: {path} ({e.strerror or e})', file=sys.stderr)
    if days > 0:
        print(f'退避した内容: {n} 個のうち、{days} 日より古い {old} 個を消しました')
    elif n:
        print(f'退避した内容が {n} 個あります ({root})。古いものを消すには --trash-days N')


def cmd_gc(st, a):
    conf = work_conf(st)
    if a.keep < 1:
        die('--keep は 1 以上にしてください (HEAD は消せません)')
    failed = 0
    names = [e['name'] for e in log_entries(st) if os.path.isdir(st.dir(e['name']))]
    for old in names[:-a.keep]:
        if old != conf.get('base'):
            try:
                force_rmtree(st.dir(old))
            except OSError as e:
                failed += 1
                print(f'消せませんでした: {old} ({e.strerror or e})', file=sys.stderr)
                continue
            print(f'消しました: {old}')
    trash_report(st, getattr(a, 'trash_days', 0))
    if failed:
        sys.exit(1)


# ---------- ハッシュの索引、重複排除、検査 ----------
# STORE/index.sqlite に、作業ツリーの各ファイルの SHA-256 を持つ。
# (サイズ, 更新時刻, inode) が記録と同じなら中身も同じとみなし、ハッシュを取り直さない。


def index_db(st):
    db = sqlite3.connect(os.path.join(st.root, 'index.sqlite'))
    # WAL にすると、コミットごとの書き換えが減る。耐久性は FULL のまま (電源断で確定済みの行を失わない)
    db.execute('PRAGMA journal_mode = WAL')
    db.execute('PRAGMA synchronous = FULL')
    db.execute('CREATE TABLE IF NOT EXISTS files (path TEXT PRIMARY KEY, size INTEGER, mtime_ns INTEGER,'
               ' ino INTEGER, sha256 TEXT, shared_with INTEGER)')
    db.execute('CREATE INDEX IF NOT EXISTS files_content ON files (sha256, size)')
    # コミットに残る「ファイルの版」。作業ツリーの現在の版と違うものは、レイヤーの中にしか無く、scrub --layers の対象
    db.execute('CREATE TABLE IF NOT EXISTS versions (id INTEGER PRIMARY KEY, path TEXT, size INTEGER, mtime_ns INTEGER,'
               ' sha256 TEXT, layer TEXT, checked_at REAL, UNIQUE (path, size, mtime_ns))')
    db.execute('CREATE TABLE IF NOT EXISTS meta (key TEXT PRIMARY KEY, value TEXT)')
    return db


def _hash(path):
    """(path, size, mtime_ns, ino, sha256)。読めなければ size=-1 で、sha256 の位置に理由が入る。"""
    try:
        before = os.lstat(path)
        h = hashlib.sha256()
        with open(path, 'rb') as f:
            while True:
                b = f.read(1 << 20)
                if not b:
                    break
                h.update(b)
        after = os.lstat(path)
        if (before.st_size, before.st_mtime_ns) != (after.st_size, after.st_mtime_ns):
            return path, -1, 0, 0, '読んでいる間に書き換えられた'
        return path, after.st_size, after.st_mtime_ns, after.st_ino, h.hexdigest()
    except OSError as e:
        return path, -1, 0, 0, e.strerror or str(e)


def hash_many(paths):
    from multiprocessing import Pool
    if len(paths) < 64:
        return [_hash(p) for p in paths]
    with Pool(min(8, os.cpu_count() or 2)) as pool:
        return pool.map(_hash, paths, chunksize=256)


def walk_files(d, sub=''):
    """作業ツリーの通常ファイルを (相対パス, lstat) で返す。リンクと、直下の管理用フォルダは除く。"""
    stack = [sub]
    while stack:
        rel = stack.pop()
        try:
            it = os.scandir(os.path.join(d, rel))
        except OSError:
            continue
        with it:
            for e in it:
                if (not rel and e.name in EXCLUDE) or e.name in PRUNE:
                    continue
                r = os.path.join(rel, e.name)
                if e.is_symlink():
                    continue
                if e.is_dir(follow_symlinks=False):
                    stack.append(r)
                elif e.is_file(follow_symlinks=False):
                    yield r, e.stat(follow_symlinks=False)


def store_hashes(db, d, rows):
    bad = []
    for path, size, mtime_ns, ino, sha in rows:
        rel = os.path.relpath(path, d)
        if size < 0:
            bad.append((rel, sha))
            db.execute('DELETE FROM files WHERE path = ?', (rel,))
        else:
            db.execute('INSERT INTO files (path, size, mtime_ns, ino, sha256, shared_with) VALUES (?,?,?,?,?,NULL)'
                       ' ON CONFLICT(path) DO UPDATE SET size=excluded.size, mtime_ns=excluded.mtime_ns,'
                       ' ino=excluded.ino, sha256=excluded.sha256, shared_with=NULL', (rel, size, mtime_ns, ino, sha))
    db.commit()
    return bad


def refresh_index(st, db):
    """索引を作業ツリーの現状に合わせる。返り値: (ハッシュを取った数, 消した数, 読めなかったもの)。"""
    d = work_dir(st)
    known = {r[0]: r[1:] for r in db.execute('SELECT path, size, mtime_ns, ino FROM files')}
    seen, todo = set(), []
    for rel, s in walk_files(d):
        seen.add(rel)
        if known.get(rel) != (s.st_size, s.st_mtime_ns, s.st_ino):
            todo.append(os.path.join(d, rel))
    bad = store_hashes(db, d, hash_many(todo))
    gone = [p for p in known if p not in seen]
    db.executemany('DELETE FROM files WHERE path = ?', [(p,) for p in gone])
    db.commit()
    return len(todo), len(gone), bad


def index_changes(st, notes):
    """コミットで変わった分だけ、索引を更新する。"""
    d = work_dir(st)
    db = index_db(st)
    todo = []
    for kind, p in notes:
        rel = p.rstrip('/')
        if kind == 'D':
            # LIKE は % や _ を任意の文字として扱うので使わない。接頭辞の比較で、下の項目だけを消す
            db.execute('DELETE FROM files WHERE path = ? OR substr(path, 1, ?) = ?', (rel, len(rel) + 1, rel + '/'))
        elif p.endswith('/'):
            if kind == 'A':
                todo += [os.path.join(d, r) for r, _ in walk_files(d, rel)]
        elif os.path.isfile(os.path.join(d, rel)) and not os.path.islink(os.path.join(d, rel)):
            todo.append(os.path.join(d, rel))
    store_hashes(db, d, hash_many(todo))
    db.close()


def record_versions(st, layer, notes):
    """コミットで追加・変更されたファイルの版を、そのレイヤーの中のコピーからハッシュして記録する
    (作業ツリーからではない: 複製のあとに変わっていても、レイヤーが持っているものを記録する)。"""
    root = st.fs(layer)
    todo = []
    for kind, p in notes:
        rel = p.rstrip('/')
        if kind == 'D':
            continue
        if p.endswith('/'):
            if kind == 'A':
                todo += [os.path.join(root, r) for r, _ in walk_files(root, rel)]
        else:
            full = os.path.join(root, rel)
            if os.path.isfile(full) and not os.path.islink(full):
                todo.append(full)
    if not todo:
        return
    db = index_db(st)
    for path, size, mtime_ns, ino, sha in hash_many(todo):
        if size < 0:
            continue
        db.execute('INSERT INTO versions (path, size, mtime_ns, sha256, layer, checked_at) VALUES (?,?,?,?,?,?)'
                   ' ON CONFLICT(path, size, mtime_ns) DO UPDATE SET sha256 = excluded.sha256, layer = excluded.layer,'
                   ' checked_at = excluded.checked_at', (os.path.relpath(path, root), size, mtime_ns, sha, layer, time.time()))
    db.commit()
    db.close()


def copy_identity(src_stat, src, dst):
    """dst (src と同じ中身のクローン) に、src の属性を移す。中身と圧縮の状態は dst のものを保つ。"""
    for name in list(xattrs(dst) or {}):
        if name not in COMPRESSION_XATTRS:
            _libc.removexattr(os.fsencode(dst), name, XATTR_NOFOLLOW)
    for name, value in (xattrs(src) or {}).items():
        if name not in COMPRESSION_XATTRS:
            _libc.setxattr(os.fsencode(dst), name, value, len(value), 0, XATTR_NOFOLLOW)
    _libc.copyfile(os.fsencode(src), os.fsencode(dst), None, 0x1 | COPYFILE_NOFOLLOW)    # ACL だけ
    try:
        os.lchown(dst, src_stat.st_uid, src_stat.st_gid)      # 所有者を変えられるのは root だけ。だめならグループだけでも写す
    except PermissionError:
        try:
            os.lchown(dst, -1, src_stat.st_gid)
        except PermissionError:
            pass
    os.chmod(dst, stat.S_IMODE(src_stat.st_mode))
    keep = os.lstat(dst).st_flags & UF_COMPRESSED
    want = (src_stat.st_flags & ~UF_COMPRESSED) | keep
    if want != os.lstat(dst).st_flags:
        os.chflags(dst, want)
    os.utime(dst, ns=(src_stat.st_atime_ns, src_stat.st_mtime_ns))


def scratch_dir(st):
    """作業ツリーの外の一時置き場。ストアの中にあるので、コミットにも作業ツリーの走査にも入らない。"""
    p = os.path.join(st.root, 'scratch')
    os.makedirs(p, exist_ok=True)
    return p


def prepare_scratch(st, d):
    """一時置き場を用意し、前回の途中終了で残った一時ファイルを消す。
    clayfsctl のロックの下で動くので、ほかに使っているものはない。作業ツリーと同じボリュームでなければ、差し替えられない。"""
    p = scratch_dir(st)
    if os.stat(p).st_dev != os.stat(d).st_dev:
        die(f'一時置き場 {p} が作業ツリーと別のボリュームにあります')
    for n in os.listdir(p):
        q = os.path.join(p, n)
        try:
            if os.path.isdir(q) and not os.path.islink(q):
                shutil.rmtree(q)
            else:
                os.unlink(q)
        except OSError as e:
            print(f'警告: 一時ファイルを消せません: {q} ({e.strerror})', file=sys.stderr)
    return p


def flush_file(p):
    """ファイルを媒体まで書き出す。macOS の fsync は媒体まで届かないので F_FULLFSYNC を使う。"""
    fd = os.open(p, os.O_RDONLY)
    try:
        try:
            fcntl.fcntl(fd, fcntl.F_FULLFSYNC)
        except (AttributeError, OSError):
            os.fsync(fd)
    finally:
        os.close(fd)


def file_digest(p):
    h = hashlib.sha256()
    with open(p, 'rb') as f:
        for buf in iter(lambda: f.read(1 << 20), b''):
            h.update(buf)
    return h.hexdigest()


_bak_seq = 0


def replace_checked(path, tmp, s, scratch):
    """tmp で path を差し替える。差し替えの間に path へ書き込みがあったら取り消して False を返す。

    差し替える前に、元の実体へ名前を 1 つ足しておく (中身は複製しない)。差し替えの後で
    元の実体の更新時刻とサイズを見て、変わっていれば元の実体を path に戻す。書き込みを失わないため。
    書き込んだ相手が差し替え後に開いた場合、その書き込みは戻した元の実体で失われうる。
    """
    global _bak_seq
    _bak_seq += 1
    bak = os.path.join(scratch, f'old.{os.getpid()}.{_bak_seq}')
    os.link(path, bak)
    try:
        os.rename(tmp, path)
    except OSError:
        os.unlink(bak)
        raise
    now = os.lstat(bak)
    if (now.st_size, now.st_mtime_ns) != (s.st_size, s.st_mtime_ns):
        os.rename(bak, path)
        return False
    os.unlink(bak)
    return True


def keep_path(d, arg):
    """引数を、作業ツリーの中の相対パスにする。作業ツリーの外は受け付けない。'.' は作業ツリー全体。"""
    base = os.path.realpath(d)
    full = os.path.realpath(arg if os.path.isabs(arg) else os.path.join(base, arg))
    rel = os.path.relpath(full, base)
    if rel == os.pardir or rel.startswith(os.pardir + os.sep) or os.path.isabs(rel):
        die(f'作業ツリーの中のパスを指定してください: {arg}')
    return rel


_seq = 0


def relink(canon, target, scratch, digest=None, checked=True):
    """target を、同じ中身の canon のクローンに置き換える (属性は target のものを保つ)。
    一時ファイルは scratch に作る。作業ツリーに置くと、途中で止まったときにコミットへ入ってしまう。

    digest を渡すと、置き換える直前に target の中身がそれと同じか確かめ、違えば何もせず ChangedError にする
    (索引のハッシュは、大きさと更新時刻が同じなら変わっていないという前提で、書き換えを見逃すことがある)。
    checked なら、置き換えの間に target へ書き込みがあったときは取り消して ChangedError にする。
    """
    global _seq
    _seq += 1
    s = os.lstat(target)
    tmp = os.path.join(scratch, f'dedup.{os.getpid()}.{_seq}')
    try:
        if digest is not None and file_digest(target) != digest:
            raise ChangedError('中身が索引の記録と違う')
        cs = os.lstat(canon)
        if not _clone(canon, tmp):
            raise OSError(ctypes.get_errno(), os.strerror(ctypes.get_errno()))
        cn = os.lstat(canon)
        if (cn.st_size, cn.st_mtime_ns) != (cs.st_size, cs.st_mtime_ns):
            raise ChangedError('複製元が複製の間に変わった')
        copy_identity(s, target, tmp)
        if os.lstat(tmp).st_size != s.st_size:
            raise OSError(0, 'クローンのサイズが違う')
        if checked:
            if not replace_checked(target, tmp, s, scratch):
                raise ChangedError('置き換えの間に書き込まれた')
        else:
            os.rename(tmp, target)
    except OSError:
        if os.path.lexists(tmp):
            os.unlink(tmp)
        raise
    except ChangedError:
        if os.path.lexists(tmp):
            os.unlink(tmp)
        raise


class ChangedError(Exception):
    """置き換えの途中で、対象か複製元が変わっていた。何も失わずに取り消した。"""


def relink_in_layers(st, canon, rel, size, mtime_ns, digest):
    """コミットの中の同じファイルも付け替える。

    コミットは作業ツリーのクローンなので、付け替える前の実体を掴み続ける。
    そのままでは、作業ツリーでまとめても容量が空かない。
    サイズと更新時刻が同じで、中身のハッシュも digest と同じものだけを付け替える
    (更新時刻を戻す書き換えがあるので、大きさと時刻だけでは決めない)。
    """
    n = 0
    scratch = scratch_dir(st)
    for layer in st.names():
        f = os.path.join(st.fs(layer), rel)
        try:
            ls = os.lstat(f)
        except OSError:
            continue
        if not stat.S_ISREG(ls.st_mode) or (ls.st_size, ls.st_mtime_ns) != (size, mtime_ns) or ls.st_nlink > 1:
            continue
        try:
            relink(canon, f, scratch, digest=digest, checked=False)
            n += 1
        except (OSError, ChangedError):
            pass
    return n


def cmd_dedup(st, a):
    d = work_dir(st)
    scratch = prepare_scratch(st, d)
    db = index_db(st)
    hashed, gone, bad = refresh_index(st, db)
    print(f'索引を更新: ハッシュを取ったファイル {hashed}、消えたファイル {gone}、読めないファイル {len(bad)}')
    for rel, why in bad[:20]:
        print(f'  読めない: {rel} ({why})')
    free_before = os.statvfs(d).f_bavail * os.statvfs(d).f_frsize
    # 開かれているファイルは差し替えない (開いている側は、名前を失った古い実体へ書き続け、書き込みが消える)。
    # 調べられなければ、何も書き換えずに止まる。dry-run は見積もりだけなので、調べられなくても続ける
    open_files = (open_files_on_volume(st) or set()) if a.dry_run else require_open_files(st)
    last_open = time.time()

    groups = files = est = skipped = in_layers = changed = 0
    # 1 回の問い合わせで、同じ中身の組を大きい順に取り出す (組ごとに引き直すと、件数の 2 乗の時間がかかる)
    import itertools
    cur = db.execute('SELECT sha256, size, path, mtime_ns, ino, shared_with FROM files WHERE size > 0'
                     ' AND (sha256, size) IN (SELECT sha256, size FROM files WHERE size > 0'
                     '                        GROUP BY sha256, size HAVING COUNT(*) > 1)'
                     ' ORDER BY size DESC, sha256, path').fetchall()
    for (sha, size), members in itertools.groupby(cur, key=lambda r: (r[0], r[1])):
        rows = [m[2:] for m in members]
        if not a.dry_run and time.time() - last_open > 60:
            open_files = require_open_files(st)
            last_open = time.time()
        # 記録の後で変わったもの、ハードリンク、変更禁止のもの、データベース、開かれているもの、
        # 本物のリソースフォークを持つものは触らない
        live = []
        for rel, mtime_ns, ino, shared in rows:
            path = os.path.join(d, rel)
            try:
                s = os.lstat(path)
            except OSError:
                continue
            if (s.st_size, s.st_mtime_ns, s.st_ino) != (size, mtime_ns, ino) or s.st_nlink > 1 or s.st_flags & IMMUTABLE:
                skipped += 1
                continue
            if os.path.splitext(rel)[1].lower() in DATABASE_EXTS or os.path.basename(rel) in DATABASE_NAMES \
                    or os.path.realpath(path) in open_files or has_real_rsrc(path, s.st_flags):
                skipped += 1
                continue
            live.append((rel, s, shared))
        if len(live) < 2:
            continue
        # 圧縮済みのものがあれば、それを元にする (クローンも圧縮されたまま共有される)
        live.sort(key=lambda x: (not x[1].st_flags & UF_COMPRESSED, x[0]))
        canon_rel, canon_stat, _ = live[0]
        canon = os.path.join(d, canon_rel)
        canon_digest = None
        if not a.dry_run:
            # 索引のハッシュは、大きさと更新時刻が同じなら変わっていないという前提で取ったもの。複製元の中身を、いま確かめる
            try:
                canon_digest = file_digest(canon)
            except OSError:
                skipped += len(live) - 1
                continue
            if canon_digest != sha:
                skipped += len(live) - 1
                db.execute('DELETE FROM files WHERE path = ?', (canon_rel,))      # 索引が古い。次回ハッシュを取り直す
                print(f'  飛ばした (複製元の中身が索引と違う): {canon_rel}', file=sys.stderr)
                continue
        did = False
        for rel, s, shared in live[1:]:
            if shared == canon_stat.st_ino:
                continue                      # 前回すでにこの元へまとめた
            did = True
            files += 1
            est += s.st_blocks * 512
            if a.dry_run:
                continue
            target = os.path.join(d, rel)
            try:
                relink(canon, target, scratch, digest=canon_digest)
            except (OSError, ChangedError) as e:
                files -= 1
                est -= s.st_blocks * 512
                skipped += 1
                if isinstance(e, ChangedError):
                    changed += 1
                    if str(e) == '中身が索引の記録と違う':
                        db.execute('DELETE FROM files WHERE path = ?', (rel,))      # 次回ハッシュを取り直す
                print(f'  飛ばした: {rel} ({getattr(e, "strerror", None) or e})', file=sys.stderr)
                continue
            in_layers += relink_in_layers(st, canon, rel, size, s.st_mtime_ns, canon_digest)
            n = os.lstat(target)
            db.execute('UPDATE files SET ino = ?, mtime_ns = ?, shared_with = ? WHERE path = ?',
                       (n.st_ino, n.st_mtime_ns, canon_stat.st_ino, rel))
        if did:
            groups += 1
        db.commit()
    free_after = os.statvfs(d).f_bavail * os.statvfs(d).f_frsize
    verb = 'まとめられる' if a.dry_run else 'まとめた'
    print(f'{verb}: {groups} 組、{files} ファイル、見積もり {est / (1 << 20):.0f} MB (飛ばした {skipped})')
    if changed:
        print(f'  置き換えの前後で変わっていたため取り消したファイル: {changed}')
    if not a.dry_run:
        print(f'コミットの中で付け替えたファイル: {in_layers}')
        print(f'空き容量の増加: {(free_after - free_before) / (1 << 20):.0f} MB')
    db.close()


def seed_versions(st, db):
    """既存のコミットから、作業ツリーの現在の版と違う版を拾って、ハッシュ無しで記録する (最初の 1 回)。
    古いコミットから順に lstat だけで調べるので、読み出しは無い。ハッシュは、scrub --layers が予算の範囲で取る。"""
    d = work_dir(st)
    layers = [n for n in st.names() if os.path.isdir(st.fs(n))]
    seen = {}      # path -> {(size, mtime_ns): 最初に持っていたレイヤー}
    for n in layers:
        root = st.fs(n)
        for rel, s in walk_files(root):
            seen.setdefault(rel, {}).setdefault((s.st_size, s.st_mtime_ns), n)
    current = {r[0]: (r[1], r[2]) for r in db.execute('SELECT path, size, mtime_ns FROM files')}
    added = 0
    for rel, vs in seen.items():
        for (size, mtime_ns), n in vs.items():
            if current.get(rel) == (size, mtime_ns):
                continue
            db.execute('INSERT OR IGNORE INTO versions (path, size, mtime_ns, sha256, layer, checked_at) VALUES (?,?,?,NULL,?,NULL)',
                       (rel, size, mtime_ns, n))
            added += 1
    db.execute("INSERT OR REPLACE INTO meta (key, value) VALUES ('versions_seeded', ?)", (str(time.time()),))
    db.commit()
    return added


def scrub_layers(st, db, budget_mb):
    """コミットの中にしか無い古い版を検査する。返り値: (一致, 新しくハッシュを記録, 問題の一覧, 残り, 消した行)。
    作業ツリーの現在の版と同じものは、作業ツリーの検査 (scrub) と同じ領域を共有するので、ここでは見ない。"""
    layers = [n for n in st.names() if os.path.isdir(st.fs(n))]
    current = {r[0]: (r[1], r[2]) for r in db.execute('SELECT path, size, mtime_ns FROM files')}
    rows = db.execute('SELECT id, path, size, mtime_ns, sha256, layer FROM versions'
                      ' ORDER BY checked_at IS NOT NULL, checked_at, id').fetchall()
    budget = budget_mb * (1 << 20) if budget_mb else None
    todo, used, gone, skipped_cur, rest = [], 0, [], 0, 0
    for vid, rel, size, mtime_ns, sha, layer in rows:
        if current.get(rel) == (size, mtime_ns):
            skipped_cur += 1
            continue
        if budget is not None and used + size > budget and todo:
            rest += 1
            continue
        # この版を持つレイヤーを探す: 記録したレイヤーが残っていればそれ、無ければ古い順に
        found = None
        for n in ([layer] if layer in layers else []) + layers:
            try:
                ls = os.lstat(os.path.join(st.fs(n), rel))
            except OSError:
                continue
            if stat.S_ISREG(ls.st_mode) and (ls.st_size, ls.st_mtime_ns) == (size, mtime_ns):
                found = n
                break
        if found is None:
            # 全レイヤーを探しても無い: その版はもう誰も持っていない (gc で消えた)。行を消す。
            # ファイルが壊れて消えた場合と区別できないので、記録したレイヤーが残っているときは問題として報告する
            if layer in layers:
                todo.append((vid, rel, size, mtime_ns, sha, layer, None))
            else:
                gone.append(vid)
            continue
        used += size
        todo.append((vid, rel, size, mtime_ns, sha, found, os.path.join(st.fs(found), rel)))
    ok = fresh = 0
    broken = []
    results = hash_many([t[6] for t in todo if t[6]])
    by_path = {r[0]: r for r in results}
    for vid, rel, size, mtime_ns, sha, layer, full in todo:
        if full is None:
            broken.append((layer, rel, 'ファイルがありません'))
            continue
        _, sz, mt, _, got = by_path[full]
        if sz < 0:
            broken.append((layer, rel, got))
        elif sha is None:
            db.execute('UPDATE versions SET sha256 = ?, layer = ?, checked_at = ? WHERE id = ?', (got, layer, time.time(), vid))
            fresh += 1
        elif got != sha:
            broken.append((layer, rel, '中身が記録したハッシュと違う'))
        else:
            db.execute('UPDATE versions SET layer = ?, checked_at = ? WHERE id = ?', (layer, time.time(), vid))
            ok += 1
    db.executemany('DELETE FROM versions WHERE id = ?', [(g,) for g in gone])
    db.commit()
    return ok, fresh, broken, rest, len(gone)


def cmd_scrub_layers(st, a):
    db = index_db(st)
    if a.seed or not db.execute("SELECT 1 FROM meta WHERE key = 'versions_seeded'").fetchone():
        refresh_index(st, db)       # 作業ツリーの現在の版を、先に索引に反映する
        n = seed_versions(st, db)
        print(f'既存のコミットから、作業ツリーと違う版を {n} 個拾いました')
    ok, fresh, broken, rest, gone = scrub_layers(st, db, a.budget_mb)
    print(f'コミットの検査: 一致 {ok}、新しくハッシュを記録 {fresh}、問題 {len(broken)}、残り {rest}、誰も持たなくなって記録から消した {gone}')
    for layer, rel, why in broken[:50]:
        print(f'  問題: {rel} ({layer}: {why})')
    db.close()
    if broken:
        sys.exit(1)


def cmd_scrub(st, a):
    if a.layers:
        return cmd_scrub_layers(st, a)
    d = work_dir(st)
    db = index_db(st)
    hashed, gone, bad = refresh_index(st, db)
    rows = {r[0]: r[1:] for r in db.execute('SELECT path, size, mtime_ns, sha256 FROM files')}
    results = hash_many([os.path.join(d, rel) for rel in rows])
    ok = changed = 0
    broken = list(bad)
    for path, size, mtime_ns, ino, sha in results:
        rel = os.path.relpath(path, d)
        want = rows[rel]
        if size < 0:
            broken.append((rel, sha))
        elif (size, mtime_ns) != want[:2]:
            changed += 1                     # 検査の間に書き換えられた (壊れたのではない)
        elif sha != want[2]:
            broken.append((rel, '中身が記録したハッシュと違う'))
        else:
            ok += 1
    print(f'検査: 一致 {ok}、検査中に更新 {changed}、新しく記録 {hashed}、問題 {len(broken)}')
    for rel, why in broken[:50]:
        print(f'  問題: {rel} ({why})')
    db.close()
    if broken:
        sys.exit(1)


def ditto(src, dst):
    """透過圧縮をかけながらコピーする。--noclone が無いと、同じボリューム内ではクローンになり圧縮されない。"""
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    r = subprocess.run(['ditto', '--hfsCompression', '--noclone', src, dst], capture_output=True, text=True)
    if r.returncode:
        DITTO_FAILED.append(src)
        print(f'警告: コピーできませんでした: {src} ({r.stderr.strip()[:120]})', file=sys.stderr)
    return r.returncode == 0


