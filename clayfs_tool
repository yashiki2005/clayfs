#!/usr/bin/env python3
"""clayfs_tool - clayfsctl が使う本体。APFS のクローンでディレクトリのコミットを持つ。

作業ディレクトリ DIR と、コミットを置くストア STORE を、同じ APFS ボリューム (ふつうは同じイメージの中) に置く。
コミットのたびに DIR の中身を clonefile(2) で STORE に複製して残す。クローンはボリュームをまたげないが、
同じボリュームの中なら、コミットが使う容量は、その後に変更されたファイルの分だけで済む。
読み書きの経路にファイルシステムの層は入らず、DIR もコミットも普通の APFS。
ふだんは clayfsctl から呼ぶ (設定や排他、イメージの扱いは clayfsctl が受け持つ)。

  clayfs_tool -s STORE -C DIR fill SRC               SRC の中身を DIR へコピーする (最初の取り込み。読めないものは飛ばす)
  clayfs_tool -s STORE -C DIR status [-s] [-q]       最後のコミットからの変更 (-q: 変更があれば終了コード 1)
  clayfs_tool -s STORE -C DIR diff [PATH...]         変更の中身 (最後のコミットとの差分)
  clayfs_tool -s STORE -C DIR commit [-m MSG]        現状をコミットする
  clayfs_tool -s STORE -C DIR log [-n N]             コミットの一覧
  clayfs_tool -s STORE -C DIR show [GEN]             そのコミットの変更一覧 (省略時は HEAD)
  clayfs_tool -s STORE -C DIR restore [--source GEN] PATH... | --all
                                                     コミット時の内容に戻す (今のものは STORE/trash へ退避)
  clayfs_tool -s STORE -C DIR gc --keep N            新しい N 個を残して、古いコミットの中身を消す (一覧は残る)
  clayfs_tool -s STORE -C DIR dedup [--dry-run]      中身が同じファイルをクローンにまとめる
  clayfs_tool -s STORE -C DIR scrub                  記録したハッシュと中身を照合する (壊れていれば終了コード 1)
  clayfs_tool -s STORE -C DIR compress [--dry-run] [PATH...]
                                                     7 日以上更新のないファイルと、圧縮を保つパスを透過圧縮する
  clayfs_tool -s STORE -C DIR keep [PATH...]         パスを圧縮を保つ対象にして圧縮する (引数なしは一覧)
  clayfs_tool -s STORE -C DIR unkeep PATH...         対象から外し、残りの対象に含まれないものを非圧縮に戻す
  clayfs_tool -s STORE -C DIR rebuild-into NEWROOT --mode fresh|replay
                                                     マウント済みの新しいボリューム NEWROOT に、圧縮して入れ直す
コミットは HEAD、または名前の一部 (一意に決まる範囲) で指定できる。
過去のコミットの中身は STORE/layers/コミット名/fs にあり、普通のフォルダとして開ける。
-C を省くと STORE の親を DIR とみなす (STORE を DIR/.clayfs に置く使い方。直下の .clayfs はコミットに含めない)。

レイヤーを直接扱う (Docker 風の使い方):
  import NAME DIR / prepare NAME PARENT / layer-commit NAME / layer-diff NAME [-o FILE]
  apply NAME PARENT TAR / path NAME / ls / rm NAME
"""
import argparse
import ctypes
import fcntl
import hashlib
import json
import os
import shutil
import sqlite3
import stat
