def open_files_on_volume(st):
    """ボリューム上で開かれているファイルの実体パスの集合を返す。"""
    mnt = os.path.dirname(st.root)
    try:
        r = subprocess.run(['lsof', '-Fn', mnt], capture_output=True, text=True, timeout=5)
        if r.returncode == 0:
            return {os.path.realpath(line[1:]) for line in r.stdout.splitlines() if line.startswith('n/')}
    except Exception:
        pass
    return set()


def parked_file(st):
