def load_parked(st):
    p = parked_file(st)
    if os.path.exists(p):
        try:
            with open(p, 'r', encoding='utf-8') as f:
                data = json.load(f)
                if isinstance(data, list):
                    return set(data)
        except Exception:
            pass
    return set()


def save_parked(st, parked_set):
    p = parked_file(st)
    with open(p, 'w', encoding='utf-8') as f:
        json.dump(sorted(list(parked_set)), f, ensure_ascii=False, indent=2)


_comp_seq = 0


def compress_file(st, path, rel, s, scratch):
    """path を透過圧縮で置き換える。
    返り値: (成功したか, 削減ブロック数, コミット付け替え数)
    """
    global _comp_seq
    _comp_seq += 1

    # 1. 圧縮前の SHA-256 を計算
    try:
        orig_sha = file_digest(path)
    except OSError:
        return False, 0, 0

    # 2. 一時置き場へ ditto --hfsCompression --noclone で圧縮
    tmp = os.path.join(scratch, f'comp.{os.getpid()}.{_comp_seq}')
    try:
        r = subprocess.run(['ditto', '--hfsCompression', '--noclone', path, tmp], capture_output=True)
        if r.returncode != 0:
            return False, 0, 0

        st_tmp = os.lstat(tmp)
        # 圧縮の印が付いていない、またはブロック数が減っていない場合は縮まないのでやめる
        if not (st_tmp.st_flags & UF_COMPRESSED) or st_tmp.st_blocks >= s.st_blocks:
            return False, 0, 0

        # 3. 媒体まで書き出してから、読み戻してハッシュが一致することを確かめる
        flush_file(tmp)
        if file_digest(tmp) != orig_sha:
            print(f'警告: 圧縮後のハッシュが一致しません: {rel}', file=sys.stderr)
            return False, 0, 0

        # 4. 圧縮中に元のファイルが変更されていないか確認
        s_now = os.lstat(path)
        if (s_now.st_size, s_now.st_mtime_ns) != (s.st_size, s.st_mtime_ns):
            return False, 0, 0

        # 5. 属性を元ファイルから tmp へ移す (copy_identity は UF_COMPRESSED を保持する)
        copy_identity(s, path, tmp)

        # 6. 元のファイルと差し替える。途中で書き込まれていたら取り消す
        if not replace_checked(path, tmp, s, scratch):
            print(f'飛ばした (圧縮中に書き換えられた): {rel}', file=sys.stderr)
            return False, 0, 0
    except OSError:
        return False, 0, 0
    finally:
        if os.path.lexists(tmp):
            try:
                os.unlink(tmp)
            except OSError:
                pass

    # 7. コミットの中の同一ファイルも付け替える (クローンで共有され容量が空く)
    in_layers = relink_in_layers(st, path, rel, s.st_size, s.st_mtime_ns)
    saved_blocks = s.st_blocks - os.lstat(path).st_blocks
    return True, max(0, saved_blocks), in_layers


_uncomp_seq = 0


def uncompress_file(path, rel, s, scratch):
    """圧縮された path を非圧縮に戻す。compress と同じく、媒体まで書いてから中身を照合する。"""
    global _uncomp_seq
    _uncomp_seq += 1

    if not (s.st_flags & UF_COMPRESSED):
        return False

    tmp = os.path.join(scratch, f'uncomp.{os.getpid()}.{_uncomp_seq}')
    try:
        h0 = hashlib.sha256()
        with open(path, 'rb') as f_in, open(tmp, 'wb') as f_out:
            for buf in iter(lambda: f_in.read(1 << 20), b''):
                h0.update(buf)
                f_out.write(buf)
        flush_file(tmp)
        if file_digest(tmp) != h0.hexdigest():
            print(f'警告: 非圧縮に戻したあとのハッシュが一致しません: {rel}', file=sys.stderr)
            return False

        # 属性を写すが UF_COMPRESSED は除外する (copy_identity は dst が UF_COMPRESSED でなければ落とす)
        copy_identity(s, path, tmp)
        if not replace_checked(path, tmp, s, scratch):
            print(f'飛ばした (書き換えられた): {rel}', file=sys.stderr)
            return False
        return True
    except OSError:
        return False
    finally:
        if os.path.lexists(tmp):
            try:
                os.unlink(tmp)
            except OSError:
                pass


def cmd_compress(st, a):
    d = work_dir(st)
    dry_run = getattr(a, 'dry_run', False)
    db = index_db(st)
    # 空実行は作業ツリーも索引も書き換えない。対象の決定には索引が要らない
    if not dry_run:
        scratch = prepare_scratch(st, d)
        refresh_index(st, db)
    now = time.time()
    seven_days_ago = now - 7 * 86400
    parked = load_parked(st)
    open_files = open_files_on_volume(st)
    last_open = time.time()

    free_before = os.statvfs(d).f_bavail * os.statvfs(d).f_frsize

    # 対象ファイルの決定
    paths_arg = getattr(a, 'paths', None)
    force_all_age = bool(paths_arg)
    candidates = []

    if paths_arg:
        for p in paths_arg:
            if os.path.isabs(p):
                full = os.path.realpath(p)
            else:
                full = os.path.realpath(p)
                if not (full.startswith(d + os.sep) or full == d):
                    full = os.path.realpath(os.path.join(d, p))
            if not full.startswith(d + os.sep) and full != d:
                die(f'{d} の外のパスは指定できません: {p}')
            rel_base = os.path.relpath(full, d)
            if os.path.isfile(full) and not os.path.islink(full):
                candidates.append((rel_base, os.lstat(full)))
            elif os.path.isdir(full):
                for r, s in walk_files(d, sub=rel_base if rel_base != '.' else ''):
                    candidates.append((r, s))
    else:
        for r, s in walk_files(d):
            candidates.append((r, s))

    count = 0
    saved_bytes = 0
    in_layers_total = 0
    skipped = 0

    for rel, s in candidates:
        # 開かれているファイルの一覧は、実行の途中でも新しくする。長い実行の間に開かれたものを見落とさないため
        if time.time() - last_open > 60:
            open_files = open_files_on_volume(st)
            last_open = time.time()
        # 既に圧縮済み
        if s.st_flags & UF_COMPRESSED:
            continue
        # 変更禁止
        if s.st_flags & IMMUTABLE:
            skipped += 1
            continue
        # 1 ブロック (4KiB) に収まる小さいファイルは除外
        if s.st_size <= 4096:
            continue
        # ハードリンク
        if s.st_nlink > 1:
            skipped += 1
            continue

        top = rel.split(os.sep)[0]
        is_parked = top in parked

        # 畳んだプロジェクトでなく、明示指定でもなければ 7 日以上前のものに限定
        if not force_all_age and not is_parked:
            if s.st_mtime > seven_days_ago:
                continue

        # 拡張子・ファイル名チェック
        ext = os.path.splitext(rel)[1].lower()
        if ext in ALREADY_COMPRESSED_EXTS:
            continue
        if ext in DATABASE_EXTS or os.path.basename(rel) in DATABASE_NAMES:
            continue

        path = os.path.join(d, rel)
        if os.path.realpath(path) in open_files:
            skipped += 1
            continue

        if dry_run:
            count += 1
            continue

        ok, saved_blocks, in_layers = compress_file(st, path, rel, s, scratch)
        if ok:
            count += 1
            saved_bytes += saved_blocks * 512
            in_layers_total += in_layers
            new_s = os.lstat(path)
            db.execute('UPDATE files SET ino = ?, mtime_ns = ? WHERE path = ?',
                       (new_s.st_ino, new_s.st_mtime_ns, rel))
        else:
            skipped += 1

    db.commit()
    db.close()
    if dry_run:
        print(f'圧縮対象: {count} ファイル (飛ばす予定 {skipped})')
        return

    free_after = os.statvfs(d).f_bavail * os.statvfs(d).f_frsize
    print(f'透過圧縮: {count} ファイル、削減 {saved_bytes / (1 << 20):.1f} MB (飛ばした {skipped})')
    if in_layers_total:
        print(f'コミットの中で付け替えたファイル: {in_layers_total}')
    print(f'空き容量の増加: {(free_after - free_before) / (1 << 20):.1f} MB')


def cmd_park(st, a):
    d = work_dir(st)
    parked = load_parked(st)

    projects_arg = getattr(a, 'projects', None)
    if not projects_arg:
        if not parked:
            print('畳まれているプロジェクトはありません')
        else:
            print(f'畳まれているプロジェクト: {", ".join(sorted(parked))}')
        return

    names = []
    for proj in projects_arg:
        proj_name = project_name(d, proj)
        proj_dir = os.path.join(d, proj_name)
        if not os.path.isdir(proj_dir):
            die(f'プロジェクトのディレクトリがありません: {proj_name}')
        parked.add(proj_name)
        names.append(proj_name)
        print(f'プロジェクト『{proj_name}』を畳みました (圧縮を実行します)')
    save_parked(st, parked)

    # 畳んだプロジェクトの圧縮を直ちに実行
    cmd_compress(st, argparse.Namespace(paths=[os.path.join(d, n) for n in names], dry_run=False))


def cmd_unpark(st, a):
    d = work_dir(st)
    parked = load_parked(st)
    db = index_db(st)
    scratch = prepare_scratch(st, d)

    for proj in a.projects:
        proj_name = project_name(d, proj)
        if proj_name in parked:
            parked.remove(proj_name)
            print(f'プロジェクト『{proj_name}』の印を外しました (非圧縮に戻します)')
        else:
            print(f'プロジェクト『{proj_name}』は畳まれていません (非圧縮に戻します)')

        proj_dir = os.path.join(d, proj_name)
        if not os.path.isdir(proj_dir):
            continue

        uncomp_count = 0
        for rel, s in walk_files(d, sub=proj_name):
            if s.st_flags & UF_COMPRESSED:
                path = os.path.join(d, rel)
                if uncompress_file(path, rel, s, scratch):
                    uncomp_count += 1
                    new_s = os.lstat(path)
                    db.execute('UPDATE files SET ino = ?, mtime_ns = ? WHERE path = ?',
                               (new_s.st_ino, new_s.st_mtime_ns, rel))
        print(f'  {proj_name}: {uncomp_count} ファイルを非圧縮に戻しました')

    save_parked(st, parked)
    db.commit()
    db.close()


def cmd_rebuild_into(st, a):
    """新しいボリュームに work/ と store/ を作り直す。元の側は読むだけで、書き換えない。

    fresh:  今の作業ツリーを圧縮して入れ、それを最初のコミットにする (履歴は引き継がない)
    replay: 残っているコミットを古い順に再現する。最初の 1 つを丸ごと入れ、以後は変更一覧の分だけ入れる
    """
    global WORK_DIR
    old_work = work_dir(st)
    conf = work_conf(st)
    new_root = os.path.realpath(a.dest)
    new_work = os.path.join(new_root, 'work')
    if os.path.exists(new_work) or os.path.exists(os.path.join(new_root, 'store')):
        die(f'入れ直し先が空ではありません: {new_root}')
    os.mkdir(new_work)
    nst = Store(os.path.join(new_root, 'store'))
    if os.path.exists(parked_file(st)):
        shutil.copy2(parked_file(st), parked_file(nst))
    nconf = {'base': None}
    t0, c0 = time.time(), os.times()

    def copy_all(src_root):
        for n in top_entries(src_root):
            ditto(os.path.join(src_root, n), os.path.join(new_work, n))

    def apply(src_root, notes):
        for kind, p in notes:
            rel = p.rstrip('/')
            src, dst = os.path.join(src_root, rel), os.path.join(new_work, rel)
            if kind == 'M' and p.endswith('/'):
                continue
            remove(dst)
            if kind != 'D' and os.path.lexists(src):
                ditto(src, dst)

    def commit(name, msg, notes, when=None):
        WORK_DIR = new_work
        globals()['WORK_DIR'] = new_work
        got = snapshot(nst, nconf, name)
        record(nst, got, msg, notes, when)
        nconf['base'] = got
        save_work_conf(nst, nconf)
        globals()['WORK_DIR'] = old_work
        return got

    def dedup_new():
        # 最初のコミットの前にまとめる。コミットが無いうちなら、付け替えは作業ツリーの中だけで済む
        globals()['WORK_DIR'] = new_work
        cmd_dedup(nst, argparse.Namespace(dry_run=False))
        globals()['WORK_DIR'] = old_work

    if a.mode == 'fresh':
        copy_all(old_work)
        dedup_new()
        commit(None, '入れ直し (履歴なし)', [])
        n = 1
    else:
        gens = [e for e in log_entries(st) if os.path.isdir(st.dir(e['name']))]
        if not gens:
            die('再現できるコミットがありません')
        copy_all(st.fs(gens[0]['name']))
        dedup_new()
        commit(gens[0]['name'], gens[0]['message'], [], gens[0]['time'])
        for e in gens[1:]:
            with open(changes_file(st, e['name'])) as f:
                notes = [tuple(line.rstrip('\n').split(' ', 1)) for line in f if line[:1] != '#' and line.strip()]
            apply(st.fs(e['name']), notes)
            commit(e['name'], e['message'], notes, e['time'])
        # 最後のコミットの後に作業ツリーで変わった分
        pending = visible(work_changes(st, conf))
        if pending:
            apply(old_work, pending)
            commit(None, '入れ直しの時点の未コミット分', pending)
        n = len(gens) + bool(pending)
    c1 = os.times()
    cpu = (c1.user - c0.user) + (c1.system - c0.system) + (c1.children_user - c0.children_user) + (c1.children_system - c0.children_system)
    v = os.statvfs(new_root)
    print(f'入れ直し ({a.mode}): コミット {n} 個、{time.time() - t0:.0f} 秒、CPU {cpu:.0f} 秒、'
          f'ボリュームの使用量 {(v.f_blocks - v.f_bfree) * v.f_frsize / (1 << 30):.2f} GB')


def main():
    ap = argparse.ArgumentParser(prog='clayfs_tool', description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('-s', '--store', default=os.environ.get('CLAYFS_STORE', '~/.src.clayfs/store'))
    ap.add_argument('-C', '--dir', help='作業ディレクトリ (省略時は STORE の親)')
    sub = ap.add_subparsers(dest='cmd', required=True)

    p = sub.add_parser('import'); p.add_argument('name'); p.add_argument('dir'); p.set_defaults(fn=cmd_import)
    p = sub.add_parser('prepare'); p.add_argument('name'); p.add_argument('parent'); p.set_defaults(fn=cmd_prepare)
    p = sub.add_parser('layer-commit'); p.add_argument('name'); p.set_defaults(fn=cmd_commit)
    p = sub.add_parser('layer-diff'); p.add_argument('name'); p.add_argument('-o', '--output'); p.set_defaults(fn=cmd_diff)
    p = sub.add_parser('apply'); p.add_argument('name'); p.add_argument('parent'); p.add_argument('tar'); p.set_defaults(fn=cmd_apply)
    p = sub.add_parser('path'); p.add_argument('name'); p.set_defaults(fn=cmd_path)
    p = sub.add_parser('ls'); p.set_defaults(fn=cmd_ls)
    p = sub.add_parser('rm'); p.add_argument('name'); p.add_argument('-f', '--force', action='store_true'); p.set_defaults(fn=cmd_rm)

    p = sub.add_parser('fill'); p.add_argument('src'); p.set_defaults(fn=cmd_fill)
    p = sub.add_parser('status'); p.add_argument('-q', '--quiet', action='store_true')
    p.add_argument('-s', '--short', action='store_true'); p.set_defaults(fn=cmd_status)
    p = sub.add_parser('diff'); p.add_argument('paths', nargs='*'); p.set_defaults(fn=cmd_wdiff)
    p = sub.add_parser('commit'); p.add_argument('-m', '--message'); p.add_argument('--allow-empty', action='store_true'); p.set_defaults(fn=cmd_wcommit)
    p = sub.add_parser('restore'); p.add_argument('paths', nargs='*'); p.add_argument('--all', action='store_true')
    p.add_argument('--source'); p.set_defaults(fn=cmd_restore)
    p = sub.add_parser('log'); p.add_argument('-n', type=int); p.set_defaults(fn=cmd_log)
    p = sub.add_parser('show'); p.add_argument('gen', nargs='?'); p.set_defaults(fn=cmd_show)
    p = sub.add_parser('dedup'); p.add_argument('--dry-run', action='store_true'); p.set_defaults(fn=cmd_dedup)
    p = sub.add_parser('scrub'); p.set_defaults(fn=cmd_scrub)
    p = sub.add_parser('compress'); p.add_argument('paths', nargs='*'); p.add_argument('--dry-run', action='store_true'); p.set_defaults(fn=cmd_compress)
    p = sub.add_parser('park'); p.add_argument('projects', nargs='*'); p.set_defaults(fn=cmd_park)
    p = sub.add_parser('unpark'); p.add_argument('projects', nargs='+'); p.set_defaults(fn=cmd_unpark)
    p = sub.add_parser('rebuild-into'); p.add_argument('dest'); p.add_argument('--mode', choices=['fresh', 'replay'], required=True); p.set_defaults(fn=cmd_rebuild_into)
    p = sub.add_parser('gc'); p.add_argument('--keep', type=int, required=True); p.set_defaults(fn=cmd_gc)

    a = ap.parse_args()
    global WORK_DIR
    if a.dir:
        WORK_DIR = os.path.realpath(os.path.expanduser(a.dir))
        if not os.path.isdir(WORK_DIR):
            die(f'ディレクトリではありません: {WORK_DIR}')
    a.fn(Store(a.store), a)


if __name__ == '__main__':
    main()
